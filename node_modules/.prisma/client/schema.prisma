generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Bảng Phân quyền & Người dùng (Yêu cầu: Login/Register, Admin/Instructor/Student)
enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String // Sẽ mã hóa bcrypt sau
  fullName  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  // Quan hệ
  courses     Course[]     @relation("InstructorCourses")
  enrollments Enrollment[]
  submissions Submission[] // Đã thêm liên kết với Bài nộp
}

// Bảng Khóa học (Yêu cầu: Manage courses)
model Course {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  instructorId Int
  createdAt    DateTime @default(now())

  // Quan hệ
  instructor  User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  enrollments Enrollment[]
  assignments Assignment[]
}

// Bảng Ghi danh (Yêu cầu: Student enrollment)
model Enrollment {
  id         Int      @id @default(autoincrement())
  userId     Int
  courseId   Int
  enrolledAt DateTime @default(now())

  // Quan hệ
  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId]) // Một sinh viên chỉ đăng ký 1 khóa 1 lần
}

// Bảng Bài tập (Yêu cầu: Assignments, Grades)
model Assignment {
  id       Int      @id @default(autoincrement())
  title    String
  dueDate  DateTime
  courseId Int

  // Quan hệ
  course      Course       @relation(fields: [courseId], references: [id])
  submissions Submission[] // Đã thêm liên kết với Bài nộp
}

// Bảng Nộp bài và Chấm điểm mới thêm
model Submission {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  userId       Int
  fileUrl      String // Link chứa file bài tập sinh viên nộp
  grade        Float? // Điểm số (có thể trống nếu chưa chấm)
  submittedAt  DateTime @default(now()) // Thời gian nộp bài

  // Quan hệ
  assignment Assignment @relation(fields: [assignmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
}
